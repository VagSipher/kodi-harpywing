msgctxt "#32101"
msgid "Off: stops NetBird and removes startup and names. The local identity is kept. Disabling the Kodi add-on alone does not stop the tunnel."
msgstr "Off: stops NetBird and removes startup and names. The local identity is kept. Disabling the Kodi add-on alone does not stop the tunnel."

msgctxt "#32102"
msgid "NetBird Cloud: https://api.netbird.io. For a self-hosted server, enter its HTTPS management address."
msgstr "NetBird Cloud: https://api.netbird.io. For a self-hosted server, enter its HTTPS management address."

msgctxt "#32104"
msgid "Name shown in NetBird. Empty: the box name."
msgstr "Name shown in NetBird. Empty: the box name."

msgctxt "#32105"
msgid "Choose a setup key or sign in with your account by scanning a QR code."
msgstr "Choose a setup key or sign in with your account by scanning a QR code."

msgctxt "#32111"
msgid "Allows access to networks and Internet exits advertised by peers. Off still allows peers permitted by the server policy. Changes reconnect this box."
msgstr "Allows access to networks and Internet exits advertised by peers. Off still allows peers permitted by the server policy. Changes reconnect this box."

msgctxt "#32112"
msgid "Removes NetBird's inbound block: every service listening on this box (Kodi web interface, SSH, file sharing...) becomes reachable by peers the server allows. Keep this off unless needed."
msgstr "Removes NetBird's inbound block: every service listening on this box (Kodi web interface, SSH, file sharing...) becomes reachable by peers the server allows. Keep this off unless needed."

msgctxt "#32113"
msgid "Optional: name;name=NetBird IPv4. Names without an address use NetBird local DNS, refreshed every minute. Last known addresses are kept on failure and restored at boot. System DNS stays unchanged."
msgstr "Optional: name;name=NetBird IPv4. Names without an address use NetBird local DNS, refreshed every minute. Last known addresses are kept on failure and restored at boot. System DNS stays unchanged."

msgctxt "#32120"
msgid "Shows connection state, address and direct or relayed link."
msgstr "Shows connection state, address and direct or relayed link."

msgctxt "#32130"
msgid "Run setup with the remote control. Kore or Yatse can send text."
msgstr "Run setup with the remote control. Kore or Yatse can send text."

msgctxt "#32131"
msgid "Disconnects and erases this box’s local identity, after confirmation."
msgstr "Disconnects and erases this box’s local identity, after confirmation."

msgctxt "#32181"
msgid "View the systemd and Kodi journal on TV, with secrets masked, or save it locally."
msgstr "View the systemd and Kodi journal on TV, with secrets masked, or save it locally."

msgctxt "#32086"
msgid "File sharing (Samba) is open without a password: anyone on this network can read and change this box's files. Set a Samba password in CoreELEC/LibreELEC settings > Services."
msgstr "File sharing (Samba) is open without a password: anyone on this network can read and change this box's files. Set a Samba password in CoreELEC/LibreELEC settings > Services."

