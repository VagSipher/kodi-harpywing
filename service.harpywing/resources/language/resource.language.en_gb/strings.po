msgstr "Disconnecting…"

msgctxt "#32088"
msgid "Invalid server address: the tunnel is stopped until it is fixed. Enter an HTTPS URL without credentials, query or path."
msgstr "Invalid server address: the tunnel is stopped until it is fixed. Enter an HTTPS URL without credentials, query or path."

msgctxt "#32089"
msgid "Name %s already exists outside Harpy Wing’s hosts block and may override it. Check /storage/.config/hosts.conf on CoreELEC. Existing entries are kept."
msgstr "Name %s already exists outside Harpy Wing’s hosts block and may override it. Check /storage/.config/hosts.conf on CoreELEC. Existing entries are kept."
